---
import { getCollection, type CollectionEntry } from 'astro:content'
import CaseStudyReview from '../../components/CaseStudyReview.astro'

interface Props {
  project: CollectionEntry<'work'>
  claims: CollectionEntry<'claims'>[]
  relatedNote?: CollectionEntry<'notes'>
  caseStudySlugs: string[]
  worldHref?: string
}

export async function getStaticPaths() {
  const [projects, claims, notes, worlds] = await Promise.all([
    getCollection('work'),
    getCollection('claims'),
    getCollection('notes'),
    getCollection('worlds'),
  ])
  const caseStudies = projects.filter((entry) => Boolean(entry.data.caseStudy))

  return caseStudies.map((project) => ({
    params: { slug: project.id },
    props: {
      project,
      claims,
      relatedNote: notes.find((entry) => entry.id === project.data.whatBroke.noteSlug),
      caseStudySlugs: caseStudies.map((entry) => entry.id),
      worldHref: worlds.find((entry) => entry.data.published && entry.data.projectSlug === project.id) ? `/work/${project.id}/world/` : undefined,
    },
  }))
}

const { project, claims, relatedNote, caseStudySlugs, worldHref } = Astro.props as Props
---

<CaseStudyReview project={project} claims={claims} relatedNote={relatedNote} caseStudySlugs={caseStudySlugs} worldHref={worldHref} />
