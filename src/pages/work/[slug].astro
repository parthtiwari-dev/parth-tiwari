---
import { getCollection, type CollectionEntry } from 'astro:content'
import CaseStudyReview from '../../components/CaseStudyReview.astro'

interface Props {
  project: CollectionEntry<'work'>
  claims: CollectionEntry<'claims'>[]
  relatedNote?: CollectionEntry<'notes'>
  caseStudySlugs: string[]
}

export async function getStaticPaths() {
  const [projects, claims, notes] = await Promise.all([
    getCollection('work'),
    getCollection('claims'),
    getCollection('notes'),
  ])
  const caseStudies = projects.filter((entry) => Boolean(entry.data.caseStudy))

  return caseStudies.map((project) => ({
    params: { slug: project.id },
    props: {
      project,
      claims,
      relatedNote: notes.find((entry) => entry.id === project.data.whatBroke.noteSlug),
      caseStudySlugs: caseStudies.map((entry) => entry.id),
    },
  }))
}

const { project, claims, relatedNote, caseStudySlugs } = Astro.props as Props
---

<CaseStudyReview project={project} claims={claims} relatedNote={relatedNote} caseStudySlugs={caseStudySlugs} />
