---
import { getCollection, type CollectionEntry } from 'astro:content'
import WorldFoundation from '../../../components/WorldFoundation.astro'
import VividWorld from '../../../components/VividWorld.astro'
import TathyaWorld from '../../../components/TathyaWorld.astro'
import { loadValidatedWorldData } from '../../../lib/worlds'

interface Props {
  project: CollectionEntry<'work'>
  world: CollectionEntry<'worlds'>
  claims: CollectionEntry<'claims'>[]
}

export async function getStaticPaths() {
  const [projects, worlds, claims] = await Promise.all([
    getCollection('work'),
    getCollection('worlds'),
    getCollection('claims'),
  ])
  return worlds
    .filter((entry) => entry.data.published)
    .map((world) => {
      const project = projects.find((entry) => entry.id === world.data.projectSlug && entry.data.caseStudy)
      if (!project) throw new Error(`Published world ${world.id} has no published paper case study.`)
      return { params: { slug: world.data.projectSlug }, props: { project, world, claims } }
    })
}

const { project, world, claims } = Astro.props as Props
const data = loadValidatedWorldData(world)
---

{data.kind === 'beatmind' ? (
  <WorldFoundation project={project} world={world} data={data.data} claims={claims} />
) : data.kind === 'vivid' ? (
  <VividWorld project={project} world={world} data={data.data} claims={claims} />
) : (
  <TathyaWorld project={project} world={world} data={data.data} claims={claims} />
)}
