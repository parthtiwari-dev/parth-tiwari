---
import { getCollection } from 'astro:content'
import LandingPage from '../components/LandingPage.astro'

const [projects, claims, notes, services, siteEntries] = await Promise.all([
  getCollection('work'),
  getCollection('claims'),
  getCollection('notes'),
  getCollection('services'),
  getCollection('site'),
])

const siteCopy = siteEntries[0]?.data
if (!siteCopy) throw new Error('The landing page requires the validated site copy entry.')
---

<LandingPage
  projects={projects}
  claims={claims}
  notes={notes}
  services={services}
  siteCopy={siteCopy}
/>
