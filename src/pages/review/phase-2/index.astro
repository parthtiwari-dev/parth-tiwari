---
import { getCollection } from 'astro:content'
import LandingScroll from '../../../components/review/LandingScroll.astro'

const [projects, claims, notes, services, siteEntries] = await Promise.all([
  getCollection('work'),
  getCollection('claims'),
  getCollection('notes'),
  getCollection('services'),
  getCollection('site'),
])

const siteCopy = siteEntries[0]?.data
if (!siteCopy) throw new Error('Phase 2 review requires the validated site copy entry.')
---

<LandingScroll
  projects={projects}
  claims={claims}
  notes={notes}
  services={services}
  siteCopy={siteCopy}
/>
