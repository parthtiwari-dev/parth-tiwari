---
import { getCollection } from 'astro:content'
import Phase2Landing from '../../../components/review/Phase2Landing.astro'

export function getStaticPaths() {
  return ['a', 'b', 'c'].map((direction) => ({ params: { direction }, props: { direction } }))
}

const { direction } = Astro.props as { direction: 'a' | 'b' | 'c' }
const [projects, claims, notes, services, siteEntries] = await Promise.all([
  getCollection('work'),
  getCollection('claims'),
  getCollection('notes'),
  getCollection('services'),
  getCollection('site'),
])

const siteCopy = siteEntries[0]?.data
if (!siteCopy) throw new Error('Phase 2 review requires the validated site copy entry.')
---

<Phase2Landing
  direction={direction}
  projects={projects}
  claims={claims}
  notes={notes}
  services={services}
  siteCopy={siteCopy}
/>
