---
import type { CollectionEntry } from 'astro:content'
import type { VividWorldDataV1 } from '../lib/worlds'
import SiteMeta from './SiteMeta.astro'
import '../styles/world-foundation.css'

interface Props {
  project: CollectionEntry<'work'>
  world: CollectionEntry<'worlds'>
  data: VividWorldDataV1
  claims: CollectionEntry<'claims'>[]
}

const { project, world, data, claims } = Astro.props as Props
const claimFor = (id: string) => claims.find((claim) => claim.id === id && claim.data.publish && claim.data.status === 'verified')
const baseline = claimFor(data.evaluation.baselineClaim)
const turbo = claimFor(data.evaluation.rejectedTurboClaim)
const serializedData = JSON.stringify(data).replaceAll('<', '\\u003c')
---

<!doctype html>
<html lang="en">
  <head>
    <SiteMeta title="Vivid world | Parth Tiwari" description={world.data.scenes[0].narration} path="/work/vivid/world/" type="article" />
  </head>
  <body class="world-foundation-page vivid-world-page">
    <a class="world-skip" href="#world-ending">Skip to the case-study handoff</a>
    <header class="world-nav">
      <a href="/work/">Back to work</a>
      <span>Vivid / Story Loom</span>
    </header>

    <main id="world-story">
      <section
        class="world-experience vivid-experience"
        data-world-root
        data-scene-count={world.data.scenes.length}
        style={`--world-primary:${world.data.accents.primary};--world-secondary:${world.data.accents.secondary};--world-fault:${world.data.accents.fault}`}
        aria-labelledby="world-title"
      >
        <figure class="world-static-frame" data-world-static>
          <img src={world.data.staticFrame.src} width={world.data.staticFrame.width} height={world.data.staticFrame.height} alt={world.data.staticFrame.alt} />
          <figcaption>Story Loom. Decorative machinery frames a real, cleared four-shot evaluation sequence and its boundaries.</figcaption>
        </figure>

        <div class="world-stage vivid-stage" data-world-stage aria-hidden="true">
          <img class="world-machinery vivid-loom-plate" src={world.data.staticFrame.src} width={world.data.staticFrame.width} height={world.data.staticFrame.height} alt="" />
          <canvas data-world-canvas aria-hidden="true"></canvas>
          <div class="world-grid"></div><div class="world-light"></div><div class="world-vignette"></div>
          <div class="world-readout"><span data-world-scene-count>01 / 08</span><span data-world-scene-label>{world.data.scenes[0].label}</span></div>
          <div class="vivid-stage-audit"><span>Cleared evaluation evidence</span><strong>Kyoto pottery / 4 shots</strong><small>Vivid commercial model licence unresolved</small></div>
          <div class="vivid-stage-key"><span>Scene plan</span><span>Neutral anchor</span><span>Reference binding</span></div>
          <div class="world-progress"><i data-world-progress></i></div>
        </div>

        <article class="world-scenes">
          {world.data.scenes.map((scene, index) => (
            <section id={scene.id === 'handoff' ? 'world-ending' : scene.id} class:list={['world-scene', index % 2 ? 'world-scene-right' : 'world-scene-left', scene.id === 'handoff' && 'world-scene-final']} data-world-scene data-scene-index={index}>
              <div class="world-scene-copy">
                <p>{scene.label}</p>
                {index === 0 ? <h1 id="world-title" tabindex="-1">{scene.heading}</h1> : <h2>{scene.heading}</h2>}
                <div class="world-narration">{scene.narration}</div>

                {scene.id === 'scene' && <ol class="vivid-plan">{data.plan.map((beat) => <li><strong>{beat.label}</strong><span>{beat.detail}</span></li>)}</ol>}

                {scene.id === 'anchor' && <figure class="vivid-anchor"><img src={data.characterAnchor.src} width={data.characterAnchor.width} height={data.characterAnchor.height} alt={data.characterAnchor.alt} /><figcaption><strong>{data.characterAnchor.label}</strong>{data.characterAnchor.continuityNote}</figcaption></figure>}

                {scene.id === 'frames' && <figure class="vivid-contact-sheet"><div>{data.frames.map((frame) => <figure><img src={frame.src} width={frame.width} height={frame.height} alt={frame.alt} loading="lazy" /><figcaption><strong>{frame.label}</strong>{frame.continuityNote}</figcaption></figure>)}</div><figcaption>Real cleared Vivid evaluation frames. These frames are evidence, not an assertion that continuity is solved.</figcaption></figure>}

                {scene.id === 'turbo' && <div class="world-evidence-boundary vivid-claim-pair">{baseline && <article><strong>{baseline.data.display}</strong><p>{baseline.data.wording}</p><small>{baseline.data.denominator}</small></article>}{turbo && <article><strong>{turbo.data.display}</strong><p>{turbo.data.wording}</p><small>{turbo.data.denominator}</small></article>}</div>}

                {scene.id === 'failure' && <div class="vivid-missing-evidence"><strong>Visual comparison unavailable</strong><p>{data.failureEvidence.explanation}</p></div>}

                {scene.id === 'boundary' && <div class="vivid-missing-evidence"><strong>Portfolio evidence, not a licence claim</strong><p>{data.portfolioUse.licenceBoundary}</p></div>}

                {scene.id === 'handoff' && <a class="world-deep-dive" href={`/work/${project.id}/`}>Read the full case study <span aria-hidden="true">→</span></a>}
              </div>
            </section>
          ))}
        </article>
      </section>
    </main>
    <script id="vivid-world-data" type="application/json" set:html={serializedData}></script>
    <script>import '../scripts/vivid-world'</script>
  </body>
</html>
