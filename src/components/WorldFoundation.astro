---
import type { CollectionEntry } from 'astro:content'
import type { BeatMindWorldDataV1 } from '../lib/worlds'
import SiteMeta from './SiteMeta.astro'
import '../styles/world-foundation.css'

interface Props {
  project: CollectionEntry<'work'>
  world: CollectionEntry<'worlds'>
  data: BeatMindWorldDataV1
  claims: CollectionEntry<'claims'>[]
}

const { project, world, data, claims } = Astro.props
const publishedClaims = project.data.claimRefs
  .map((id) => claims.find((claim) => claim.id === id))
  .filter((claim): claim is CollectionEntry<'claims'> => Boolean(claim?.data.publish && claim.data.status === 'verified'))
const serializedData = JSON.stringify(data).replaceAll('<', '\\u003c')
const signalLegend = [
  ['vocals', 'Vocals', '#f0a2c0'],
  ['backing_vocals', 'Backing', '#c58fd6'],
  ['drums', 'Drums', '#f0955a'],
  ['bass', 'Bass', '#5aa8f0'],
  ['other', 'Other', '#7de3a8'],
] as const
---

<!doctype html>
<html lang="en">
  <head>
    <SiteMeta
      title={`${project.data.title} world | Parth Tiwari`}
      description={world.data.scenes[0].narration}
      path={`/work/${project.id}/world/`}
      type="article"
    />
  </head>
  <body class="world-foundation-page">
    <a class="world-skip" href="#world-ending">Skip to the case-study handoff</a>
    <header class="world-nav">
      <a href="/work/">Back to work</a>
      <span>{project.data.title} / {world.data.selectedTreatment}</span>
    </header>

    <main id="world-story">
      <section
        class="world-experience"
        data-world-root
        data-scene-count={world.data.scenes.length}
        style={`--world-primary:${world.data.accents.primary};--world-secondary:${world.data.accents.secondary};--world-fault:${world.data.accents.fault}`}
        aria-labelledby="world-title"
      >
        <figure class="world-static-frame" data-world-static>
          <img
            src={world.data.staticFrame.src}
            width={world.data.staticFrame.width}
            height={world.data.staticFrame.height}
            alt={world.data.staticFrame.alt}
          />
          <figcaption>
            BeatMind Sound Foundry. The complete story and evidence boundaries follow in ordinary HTML.
          </figcaption>
        </figure>

        <div class="world-stage" data-world-stage aria-hidden="true">
          <img
            class="world-machinery"
            src={world.data.staticFrame.src}
            width={world.data.staticFrame.width}
            height={world.data.staticFrame.height}
            alt=""
          />
          <canvas data-world-canvas aria-hidden="true"></canvas>
          <div class="world-grid"></div>
          <div class="world-light"></div>
          <div class="world-vignette"></div>

          <div class="world-readout">
            <span data-world-scene-count>01 / {String(world.data.scenes.length).padStart(2, '0')}</span>
            <span data-world-scene-label>{world.data.scenes[0].label}</span>
          </div>

          <div class="world-audit">
            <span>Sanitized real export</span>
            <strong>{data.analysis.bpm} BPM / {data.analysis.key}</strong>
            <small>{data.analysis.durationSeconds.toFixed(3)} seconds / 5 stems / {data.analysis.sections.length} sections</small>
          </div>

          <div class="world-stem-key">
            {signalLegend.map(([, label, color]) => <span style={`--stem:${color}`}>{label}</span>)}
          </div>
          <div class="world-progress"><i data-world-progress></i></div>
        </div>

        <article class="world-scenes">
          {world.data.scenes.map((scene, index) => (
            <section
              id={scene.id === 'handoff' ? 'world-ending' : scene.id}
              class:list={['world-scene', index % 2 === 0 ? 'world-scene-left' : 'world-scene-right', scene.id === 'handoff' && 'world-scene-final']}
              data-world-scene
              data-scene-index={index}
            >
              <div class="world-scene-copy">
                <p>{scene.label}</p>
                {index === 0 ? <h1 id="world-title" tabindex="-1">{scene.heading}</h1> : <h2>{scene.heading}</h2>}
                <div class="world-narration">{scene.narration}</div>

                {scene.id === 'analysis' && (
                  <dl class="world-fact-grid">
                    <div><dt>Tempo</dt><dd>{data.analysis.bpm} BPM</dd></div>
                    <div><dt>Key</dt><dd>{data.analysis.key}</dd></div>
                    <div><dt>Detected sections</dt><dd>{data.analysis.sections.length}</dd></div>
                  </dl>
                )}

                {scene.id === 'boundary' && (
                  <div class="world-evidence-boundary">
                    {publishedClaims.map((claim) => (
                      <article>
                        <strong>{claim.data.display}</strong>
                        <p>{claim.data.wording}</p>
                        <small>{claim.data.denominator}</small>
                      </article>
                    ))}
                    <p>{world.data.audio.explanation}</p>
                    {!data.trace.available && <p>{data.trace.reason}</p>}
                  </div>
                )}

                {scene.id === 'handoff' && (
                  <a class="world-deep-dive" href={`/work/${project.id}/`}>
                    Read the full case study <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            </section>
          ))}
        </article>
      </section>
    </main>

    <script id="beatmind-world-data" type="application/json" set:html={serializedData}></script>
    <script>
      import '../scripts/beatmind-world'
    </script>
  </body>
</html>
