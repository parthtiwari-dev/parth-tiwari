---
import type { CollectionEntry } from 'astro:content'
import { BOOKING_URL, CONTACT_EMAIL_HREF, WHATSAPP_URL } from '../config/site'
import ProjectTransitionLayer from './ProjectTransitionLayer.astro'
import SiteMeta from './SiteMeta.astro'
import { projectDoorHref } from '../lib/worlds'
import '../styles/landing.css'

interface Props {
  projects: CollectionEntry<'work'>[]
  claims: CollectionEntry<'claims'>[]
  notes: CollectionEntry<'notes'>[]
  services: CollectionEntry<'services'>[]
  siteCopy: CollectionEntry<'site'>['data']
  worlds: CollectionEntry<'worlds'>[]
}

const { projects, claims, notes, services, siteCopy, worlds } = Astro.props
const orderedProjects = [...projects].sort((left, right) => left.data.order - right.data.order)
const publishedNotes = notes
  .filter((entry) => entry.data.state === 'published')
  .sort((left, right) => (right.data.publishedAt?.getTime() ?? 0) - (left.data.publishedAt?.getTime() ?? 0))
  .slice(0, 3)
const orderedServices = [...services].sort((left, right) => left.data.order - right.data.order)
const proofIds = ['beatmind-current-tests', 'beatmind-separation-benchmark', 'querypilot-correction']
const proofClaims = proofIds
  .map((id) => claims.find((claim) => claim.id === id))
  .filter((claim): claim is CollectionEntry<'claims'> => Boolean(claim?.data.publish))
const effortLabels = { flagship: 'Flagship', substantial: 'Substantial', focused: 'Focused' }
const statusLabels = { live: 'Live', shipped: 'Shipped', 'in-progress': 'In progress', running: 'Running', 'take-home': 'Take-home' }
const beatMindProject = orderedProjects.find((project) => project.id === 'beatmind')
const beatMindHref = beatMindProject ? projectDoorHref(beatMindProject, worlds) : '/work/'
---

<!doctype html>
<html lang="en">
  <head>
    <SiteMeta
      title="Parth Tiwari | AI products, systems and case studies"
      description="Parth Tiwari builds ambitious AI products and documents the decisions, measurements and failures behind them."
      path="/"
    />
  </head>
  <body class="paper-worlds-home">
    <a class="skip-link" href="#main-content">Skip to the portfolio</a>
    <ProjectTransitionLayer projects={orderedProjects} />

    <div class="unfurl-intro" aria-hidden="true">
      <div class="unfurl-shadow"></div>
      <div class="unfurl-sheet"></div>
      <div class="unfurl-crease unfurl-crease-top"></div>
      <div class="unfurl-crease unfurl-crease-bottom"></div>
      <p>A working record, unrolled.</p>
    </div>

    <main id="main-content" class="scroll-sheet">
      <div class="paper-message">
        <div class="paper-edge paper-edge-left" aria-hidden="true">
          <span class="edge-fibre-a"></span><span class="edge-fibre-b"></span><span class="edge-fibre-c"></span>
        </div>
        <div class="paper-edge paper-edge-right" aria-hidden="true">
          <span class="edge-fibre-c"></span><span class="edge-fibre-a"></span><span class="edge-fibre-b"></span>
        </div>
        <section id="arrival" class="arrival section-pad">
          <span class="ink-print ink-print-arrival" aria-hidden="true"></span>
          <div class="arrival-copy">
            <p class="eyebrow">AI engineer / Bengaluru / building end to end</p>
            <h1>{siteCopy.home.hero}</h1>
            <p class="hero-support">I’m Parth, an AI engineer in Bengaluru. This is the work, the evidence behind it, and the part that broke.</p>
            <div class="doors" aria-label="Choose how to enter the portfolio">
              <a class="door door-work" href={siteCopy.home.employerDoor.href}><span>{siteCopy.home.employerDoor.label}</span><small>{siteCopy.home.employerDoor.note}</small><b aria-hidden="true">↘</b></a>
              <a class="door door-hire" href={siteCopy.home.clientDoor.href}><span>{siteCopy.home.clientDoor.label}</span><small>{siteCopy.home.clientDoor.note}</small><b aria-hidden="true">↘</b></a>
            </div>
          </div>

          <figure class="featured-world">
            <div class="world-heading"><div><span>How this portfolio is being built</span><strong>Paper → Case study → World</strong></div><small>BeatMind / 01</small></div>
            <div class="world-screen">
              <img src="/media/beatmind-world-still.jpg" alt="BeatMind Sound Foundry study showing a source waveform inside a dark machine chamber" width="1440" height="900" decoding="async" fetchpriority="high" />
              <div class="world-scan" aria-hidden="true"></div>
              <div class="world-grammar" aria-hidden="true">
                <span><b>01</b> Read the sheet</span>
                <span><b>02</b> Enter its world</span>
                <span><b>03</b> Read the record</span>
              </div>
            </div>
            <figcaption><p>The case studies are open now. Published worlds open first, then hand off to the engineering record.</p><a href={beatMindHref}>Enter BeatMind <span aria-hidden="true">↗</span></a></figcaption>
          </figure>

          <div class="quiet-proof" aria-label="Three verified examples from the work">
            {proofClaims.map((claim, index) => <article><span>0{index + 1}</span><strong>{claim.data.display}</strong><p>{claim.data.context}</p></article>)}
          </div>
        </section>

        <div class="nav-sentinel" data-nav-sentinel aria-hidden="true"></div>
        <header class="paper-nav" data-paper-nav data-state="closed">
          <div class="paper-nav-fold">
            <div class="nav-content">
              <a class="wordmark" href="#arrival" aria-label="Parth Tiwari, back to the top">Parth Tiwari</a>
              <nav class="desktop-nav" aria-label="Portfolio navigation">
                <a href="/work/">Work</a><a href="/notes/">Notes</a><a href="/about/">About</a><a href="/resume/">Resume</a>
              </nav>
              <a class="nav-action" href="/hire/">Start a project</a>
              <details class="mobile-menu paper-mobile-menu">
                <summary><span class="menu-label-open">Menu</span><span class="menu-label-close">Close</span></summary>
                <nav aria-label="Mobile portfolio navigation">
                  <a href="/work/">Work</a><a href="/notes/">Notes</a><a href="/about/">About</a><a href="/resume/">Resume</a>
                </nav>
              </details>
            </div>
          </div>
        </header>

        <section id="about" class="about-beat section-pad ruled-section" data-reveal>
          <div class="section-heading"><p class="eyebrow">The person on the sheet</p><h2>Hi, I am Parth.</h2></div>
          <div class="intro-copy">{siteCopy.home.intro.map((paragraph) => <p>{paragraph}</p>)}<a class="text-link" href="/about/">More about how I work <span aria-hidden="true">→</span></a></div>
          <figure class="portrait-frame"><img src="/media/parth-portrait-drawn-phase2-768.png" alt="A hand-drawn study of Parth wearing a cap and sunglasses" width="768" height="1152" loading="lazy" decoding="async" /><figcaption>A drawing study from the real portrait</figcaption></figure>
        </section>

        <section id="projects" class="project-section section-pad ruled-section" data-reveal>
          <span class="ink-print ink-print-projects" aria-hidden="true"></span>
          <div class="section-heading project-heading"><div><p class="eyebrow">The register</p><h2>Work, in the order I would show it.</h2></div><p>Every project stays on the sheet. The full register will sort by build effort, recency and current status.</p></div>
          <ol class="project-register">
            {orderedProjects.map((project, index) => {
              const isPublished = Boolean(project.data.caseStudy)
              const projectHref = projectDoorHref(project, worlds)
              const rowContent = (
                <>
                  <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
                  <div class="project-name"><strong>{project.data.title}</strong><p>{project.data.summary}</p></div>
                  <span class="project-meta">{statusLabels[project.data.status]}</span><span class="project-meta effort">{effortLabels[project.data.effort]}</span><span class="project-arrow" aria-hidden="true">{isPublished ? '↗' : '—'}</span>
                </>
              )

              return (
                <li class="project-item">
                  {projectHref
                    ? <a class:list={['project-row', project.data.tier === 'flagship' && 'is-flagship']} href={projectHref} aria-label={`Open ${project.data.title}`} data-paper-project data-project-slug={project.id}>{rowContent}</a>
                    : <div class:list={['project-row', 'is-deferred', project.data.tier === 'flagship' && 'is-flagship']} aria-label={`${project.data.title}. Case study in development.`}>{rowContent}</div>}
                </li>
              )
            })}
          </ol>
          <aside class="register-behavior"><span>What opens today</span><p>Every linked row opens a complete case study. The two focused utilities stay visible while their records are prepared; the animated worlds come after the readable site is finished.</p></aside>
        </section>

        <section class="proof-section section-pad ruled-section" data-reveal>
          <div class="section-heading"><p class="eyebrow">Measured, with the denominator attached</p><h2>Proof without the victory lap.</h2></div>
          <div class="proof-grid">{proofClaims.map((claim) => <article><span class="proof-number">{claim.data.display}</span><p>{claim.data.wording}</p><small>Verified {claim.data.verifiedAt.toISOString().slice(0, 10)} / {claim.data.denominator}</small></article>)}</div>
        </section>

        <section class="services-section section-pad ruled-section" data-reveal>
          <div class="section-heading"><p class="eyebrow">Three kinds of work</p><h2>Where I can be useful.</h2></div>
          <div class="service-list">{orderedServices.map((service, index) => <article><span>0{index + 1}</span><h3>{service.data.title}</h3><p>{service.data.outcome}</p><ul>{service.data.scope.map((item) => <li>{item}</li>)}</ul></article>)}</div>
        </section>

        <section id="notes" class="notes-section section-pad ruled-section" data-reveal>
          <span class="ink-print ink-print-notes" aria-hidden="true"></span>
          <div class="section-heading notes-heading"><div><p class="eyebrow">Errata and writing</p><h2>The parts I got wrong stay public.</h2></div><div class="writing-status"><span>Writing</span><strong>Coming soon</strong><small>The errata are already open.</small></div></div>
          <div class="note-list">{publishedNotes.map((note, index) => <article><span>0{index + 1}</span><div><h3>{note.data.title}</h3><p>{note.data.summary}</p></div><small>{note.data.publishedAt?.toISOString().slice(0, 10)}</small></article>)}</div>
        </section>

        <section id="contact" class="contact-section section-pad ruled-section" data-reveal>
          <p class="eyebrow">The client door, again</p><h2>Have something real to build?</h2><p>{siteCopy.hire.intro}</p>
          <div class="contact-links"><a class="contact-action large" href={CONTACT_EMAIL_HREF}>Email Parth</a><a class="text-link" href={BOOKING_URL}>Book a call <span aria-hidden="true">↗</span></a><a class="text-link" href={WHATSAPP_URL}>WhatsApp <span aria-hidden="true">↗</span></a></div>
        </section>

        <footer class="site-footer"><strong>Parth Tiwari</strong><p>AI engineer / Bengaluru</p><a href="#arrival">Back to the top ↑</a></footer>
        <div class="paper-finish" aria-hidden="true"><span class="finish-seal"></span><span class="finish-label">The sheet continues with the work.</span></div>
      </div>
    </main>

    <script>
      import '../scripts/landing-motion'
      import '../scripts/project-transition'
    </script>
  </body>
</html>
