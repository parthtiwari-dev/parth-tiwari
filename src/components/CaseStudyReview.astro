---
import type { CollectionEntry } from 'astro:content'
import { CONTACT_EMAIL_HREF } from '../config/site'
import '../styles/case-study.css'

interface Props {
  project: CollectionEntry<'work'>
  claims: CollectionEntry<'claims'>[]
  relatedNote?: CollectionEntry<'notes'>
}

const { project, claims, relatedNote } = Astro.props
const claimById = new Map(claims.map((claim) => [claim.id, claim]))
const measurements = project.data.measurement.claimIds
  .map((id) => claimById.get(id))
  .filter((claim): claim is CollectionEntry<'claims'> => Boolean(claim?.data.publish && claim.data.status === 'verified'))
const primaryMeasurement = measurements[0]
const stackPreview = project.data.stackAndLinks.stack.slice(0, 3).join(' / ')
const statusLabel = project.data.status === 'in-progress'
  ? 'In progress'
  : project.data.status.charAt(0).toUpperCase() + project.data.status.slice(1)
const chapters = [
  ['what-it-is', 'What it is'],
  ['problem', 'The problem'],
  ['architecture', 'How it is built'],
  ['measurement', 'The measurement'],
  ['boundary', 'The boundary'],
  ['what-broke', 'What broke'],
  ['stack-and-links', 'Stack and links'],
] as const
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`${project.data.title}: ${project.data.summary}`}
    />
    <title>{project.data.title} case study | Parth Tiwari</title>
  </head>
  <body class="case-review-page">
    <a class="skip-link" href="#case-reading">Skip to the case study</a>

    <main>
      <section class="case-world" aria-labelledby="case-title">
        <header class="case-world-nav">
          <a class="case-wordmark" href="/">Parth Tiwari</a>
          <nav aria-label="Case-study navigation">
            <a href="/work/">All work</a>
            <a href="/notes/">Notes</a>
            <a href="/resume/">Resume</a>
          </nav>
          <a class="case-contact" href="/hire/">Start a project</a>
        </header>

        <div class="case-world-grid">
          <div class="case-arrival-copy">
            <p class="case-kicker">World 01 / Music systems</p>
            <h1 id="case-title">{project.data.title}</h1>
            <p class="case-arrival-sentence">{project.data.arrival.sentence}</p>

            <dl class="case-arrival-facts">
              <div><dt>Status</dt><dd>{statusLabel}</dd></div>
              <div><dt>Built</dt><dd>As part of my current role</dd></div>
              <div><dt>Core stack</dt><dd>{stackPreview}</dd></div>
            </dl>

            {primaryMeasurement && (
              <div class="case-primary-proof">
                <strong>{primaryMeasurement.data.display}</strong>
                <span>{primaryMeasurement.data.denominator}</span>
              </div>
            )}
          </div>

          <figure class="case-world-frame">
            <div class="stem-frame">
              <img
                src="/media/beatmind-stems-clean.png"
                width="1904"
                height="972"
                fetchpriority="high"
                alt="BeatMind's real four-lane separated-stem workspace"
              />
              <div class="stem-frame-caption">
                <span>Real product capture</span>
                <span>Four separated stems</span>
              </div>
            </div>
            <figcaption>A real frame now. Scroll-directed separation, mixing and recovery arrive only after storyboard approval.</figcaption>
          </figure>
        </div>

        <div class="case-story-path" aria-label="BeatMind world storyboard path">
          <span>Ingest</span><span>Separate</span><span>Analyse</span><span>Arrange</span>
          <span>Mix</span><span>Render</span><span>Worker lost</span><span>Retry</span>
          <small>Story path only: real trace timings still require export</small>
        </div>

        <div class="case-audio-invitation" aria-describedby="audio-source-note">
          <button type="button" disabled aria-label="Play an approved BeatMind audio excerpt when available">
            <span aria-hidden="true">▶</span> Hear the separation
          </button>
          <p id="audio-source-note">Opt-in by design. An approved owner-created or licensed excerpt is still required.</p>
        </div>

        <a class="case-scroll-cue" href="#case-reading">Read the case study <span aria-hidden="true">↓</span></a>
      </section>

      <section class="case-paper" id="case-reading" aria-label={`${project.data.title} case study`}>
        <div class="case-paper-edge case-paper-edge-left" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="case-paper-edge case-paper-edge-right" aria-hidden="true"><i></i><i></i><i></i></div>

        <div class="case-mobile-progress" data-mobile-progress>
          <span data-current-chapter>What it is</span>
          <progress max="100" value="0" aria-label="Case-study reading progress"></progress>
        </div>

        <div class="case-reading-layout">
          <aside class="case-reading-rail" aria-label="Case-study chapters">
            <div class="case-rail-sticky">
              <p>Reading path</p>
              <progress max="100" value="0" aria-label="Case-study reading progress"></progress>
              <nav>
                {chapters.map(([id, label], index) => (
                  <a href={`#${id}`} data-chapter-link={id} class:list={[index === 0 && 'is-current']}>
                    <span>{String(index + 1).padStart(2, '0')}</span>{label}
                  </a>
                ))}
              </nav>
              <figure>
                <img
                  src="/media/beatmind-stems-clean.png"
                  width="1904"
                  height="972"
                  loading="lazy"
                  alt="A compact view of BeatMind's separated stem lanes"
                />
                <figcaption>Static world frame</figcaption>
              </figure>
            </div>
          </aside>

          <article class="case-article">
            <section id="what-it-is" class="case-chapter case-lead" data-case-chapter>
              <p class="case-section-label">01 / What it is</p>
              <h2>A music tool whose loading states have to tell the truth.</h2>
              {project.data.whatItIs.map((paragraph) => <p>{paragraph}</p>)}
              <aside class="case-context-note">
                <span>Working context</span>
                <p>Built as part of my current role. The organization is intentionally not named here.</p>
              </aside>
            </section>

            <section id="problem" class="case-chapter" data-case-chapter>
              <p class="case-section-label">02 / The problem</p>
              <h2>The browser can stop waiting. The work cannot pretend it stopped.</h2>
              {project.data.problem.map((paragraph) => <p>{paragraph}</p>)}
            </section>

            <section id="architecture" class="case-chapter" data-case-chapter>
              <p class="case-section-label">03 / How it is built</p>
              <h2>{project.data.architecture.decision}</h2>
              {project.data.architecture.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

              <figure class="case-system-diagram">
                <figcaption>One durable path, with late work fenced out</figcaption>
                <ol>
                  <li><span>01</span><strong>Web application</strong><small>Projects and visible state</small></li>
                  <li><span>02</span><strong>Durable operation</strong><small>Stage, lock and attempt identity</small></li>
                  <li><span>03</span><strong>Remote worker</strong><small>Generation, separation or render</small></li>
                  <li><span>04</span><strong>Fenced callback</strong><small>Current result accepted; late result refused</small></li>
                </ol>
              </figure>
            </section>

            <section id="measurement" class="case-chapter case-measurement" data-case-chapter>
              <p class="case-section-label">04 / The measurement</p>
              <h2>Proof, with the denominator attached.</h2>
              <div class="measurement-ledger">
                {measurements.map((claim, index) => (
                  <article class:list={[index === 0 && 'is-primary']}>
                    <strong>{claim.data.display}</strong>
                    <p>{claim.data.wording}</p>
                    <small>{claim.data.denominator}</small>
                    <small>Verified {claim.data.verifiedAt.toISOString().slice(0, 10)}</small>
                  </article>
                ))}
              </div>
            </section>

            <section id="boundary" class="case-chapter" data-case-chapter>
              <p class="case-section-label">05 / The boundary</p>
              <h2>What it does, and what it refuses to claim.</h2>
              <div class="case-boundaries">
                <div><h3>It will</h3><ul>{project.data.boundary.will.map((item) => <li>{item}</li>)}</ul></div>
                <div><h3>It refuses</h3><ul>{project.data.boundary.refuses.map((item) => <li>{item}</li>)}</ul></div>
              </div>
            </section>

            <section id="what-broke" class="case-chapter case-erratum" data-case-chapter>
              <p class="case-section-label">06 / What broke</p>
              <h2>{project.data.whatBroke.title}</h2>
              {project.data.whatBroke.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {relatedNote && <a href={`/notes/${relatedNote.id}/`}>Read the complete erratum <span aria-hidden="true">↗</span></a>}
            </section>

            <section id="stack-and-links" class="case-chapter case-stack" data-case-chapter>
              <p class="case-section-label">07 / Stack and links</p>
              <h2>The systems underneath it.</h2>
              <ul class="case-stack-list">{project.data.stackAndLinks.stack.map((item) => <li>{item}</li>)}</ul>
              <div class="case-link-row">
                {project.data.stackAndLinks.links.map((link) => (
                  <a href={link.url.toString()} rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>
                ))}
              </div>
            </section>

            <footer class="case-ending">
              <p class="case-section-label">End of world 01</p>
              <h2>The next world turns scenes into shots.</h2>
              <div class="case-ending-links">
                <a class="case-next" href={`/work/${project.data.next.slug}/`}>{project.data.next.label} <span aria-hidden="true">→</span></a>
                <a href="/work/">Back to all work</a>
                {relatedNote && <a href={`/notes/${relatedNote.id}/`}>Related erratum</a>}
                <a href="/hire/">Start a project</a>
              </div>
              <div class="case-feedback">
                <p>Was this useful?</p>
                <a href={`/work/${project.data.next.slug}/`}>Yes, show me the next one</a>
                <a href={`${CONTACT_EMAIL_HREF}?subject=BeatMind%20case%20study%20feedback`}>Not yet, tell Parth what was missing</a>
              </div>
              <small>Phase 2 structure review. The final animated world is deliberately not built yet.</small>
            </footer>
          </article>
        </div>
      </section>
    </main>

    <script>
      import '../scripts/case-study-progress'
    </script>
  </body>
</html>
