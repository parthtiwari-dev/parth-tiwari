---
import type { CollectionEntry } from 'astro:content'
import { CONTACT_EMAIL_HREF } from '../config/site'
import '../styles/case-study.css'

interface Props {
  project: CollectionEntry<'work'>
  claims: CollectionEntry<'claims'>[]
  relatedNote?: CollectionEntry<'notes'>
}

const { project, claims, relatedNote } = Astro.props
const caseStudy = project.data.caseStudy
if (!caseStudy) throw new Error(`${project.data.title} is missing the Phase 2 case-study contract.`)

const claimById = new Map(claims.map((claim) => [claim.id, claim]))
const measurements = project.data.measurement.claimIds
  .map((id) => claimById.get(id))
  .filter((claim): claim is CollectionEntry<'claims'> => Boolean(claim?.data.publish && claim.data.status === 'verified'))
const statusLabel = project.data.status === 'in-progress'
  ? 'In progress'
  : project.data.status.charAt(0).toUpperCase() + project.data.status.slice(1)
const chapters = [
  ['overview', 'What it is'],
  ['product-demo', 'Product proof'],
  ['problem', 'Problem and role'],
  ['research', 'Research'],
  ['architecture', 'Architecture'],
  ['decisions', 'Decisions'],
  ['evidence', 'Evidence'],
  ['failures', 'What failed'],
  ['limits', 'Limits and future'],
  ['sources', 'Stack and sources'],
] as const
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`${project.data.title}: ${project.data.summary}`} />
    <title>{project.data.title} case study | Parth Tiwari</title>
  </head>
  <body class="case-review-page">
    <a class="skip-link" href="#case-reading">Skip to the case study</a>

    <main class="case-sheet">
      <div class="case-paper">
        <div class="case-paper-edge case-paper-edge-left" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="case-paper-edge case-paper-edge-right" aria-hidden="true"><i></i><i></i><i></i></div>

        <header class="case-nav">
          <a class="case-wordmark" href="/">Parth Tiwari</a>
          <nav aria-label="Portfolio navigation">
            <a aria-current="page" href="/work/">Work</a>
            <a href="/notes/">Notes</a>
            <a href="/about/">About</a>
            <a href="/resume/">Resume</a>
          </nav>
          <a class="case-contact" href="/hire/">Start a project</a>
          <details class="case-mobile-menu paper-mobile-menu">
            <summary><span class="menu-label-open">Menu</span><span class="menu-label-close">Close</span></summary>
            <nav aria-label="Mobile portfolio navigation">
              <a href="/">Home</a><a aria-current="page" href="/work/">Work</a><a href="/notes/">Notes</a><a href="/about/">About</a><a href="/resume/">Resume</a>
            </nav>
          </details>
        </header>

        <section class="case-masthead" aria-labelledby="case-title">
          <div class="case-masthead-copy">
            <p class="case-kicker">Case 01 / Music systems</p>
            <h1 id="case-title">{project.data.title}</h1>
            <p class="case-thesis">{caseStudy.thesis}</p>
            <div class="case-actions">
              <a class="case-primary-action" href="#product-demo">Watch the product <span aria-hidden="true">↓</span></a>
              {project.data.stackAndLinks.links.map((link) => (
                <a href={link.url.toString()} rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>
              ))}
            </div>
            <dl class="case-facts">
              <div><dt>Role</dt><dd>{caseStudy.credit.role}</dd></div>
              <div><dt>Built at</dt><dd>{caseStudy.credit.organization}</dd></div>
              <div><dt>Contribution</dt><dd>Design and engineering, end to end</dd></div>
              <div><dt>Status</dt><dd>{statusLabel}</dd></div>
            </dl>
          </div>

          <figure class="case-cover">
            <img
              src="/media/beatmind-desktop.jpg"
              width="2880"
              height="1800"
              fetchpriority="high"
              alt="BeatMind's real public product page showing a five-stem record visualization"
            />
            <figcaption><span>Real product surface</span><span>Five-stem model</span></figcaption>
          </figure>
        </section>

        <section class="case-proof-strip" aria-label="Verified BeatMind evidence">
          <div class="case-proof-intro">
            <p>Measured, with the denominator attached</p>
            <strong>Proof before polish.</strong>
          </div>
          {measurements.map((claim) => (
            <article>
              <strong>{claim.data.display}</strong>
              <p>{claim.data.wording}</p>
              <small>{claim.data.denominator}</small>
              <small>Verified {claim.data.verifiedAt.toISOString().slice(0, 10)}</small>
            </article>
          ))}
        </section>

        <div class="case-mobile-progress" data-mobile-progress>
          <span data-current-chapter>What it is</span>
          <progress max="100" value="0" aria-label="Case-study reading progress"></progress>
        </div>

        <section class="case-reading-layout" id="case-reading" aria-label={`${project.data.title} case study`}>
          <aside class="case-reading-rail" aria-label="Case-study chapters">
            <div class="case-rail-sticky">
              <p>Reading path</p>
              <progress max="100" value="0" aria-label="Case-study reading progress"></progress>
              <nav>
                {chapters.map(([id, label], index) => (
                  <a href={`#${id}`} data-chapter-link={id} class:list={[index === 0 && 'is-current']}>
                    <span>{String(index + 1).padStart(2, '0')}</span>{label}
                  </a>
                ))}
              </nav>
              <div class="case-rail-note">
                <span>Reading scope</span>
                <strong>Product to postmortem</strong>
                <small>Proof, architecture, failures, and limits.</small>
              </div>
            </div>
          </aside>

          <article class="case-article">
            <section id="overview" class="case-chapter case-overview" data-case-chapter>
              <p class="case-section-label">01 / What it is</p>
              <h2>More control than a prompt box. Less friction than starting in a DAW.</h2>
              {project.data.whatItIs.map((paragraph) => <p>{paragraph}</p>)}
              <div class="case-audience">
                <span>Built for</span>
                <p>{caseStudy.intendedUser}</p>
              </div>
              <blockquote>
                <p>{caseStudy.credit.contribution}</p>
                <cite>Contribution record</cite>
              </blockquote>
            </section>

            <section id="product-demo" class="case-chapter case-demo" data-case-chapter>
              <p class="case-section-label">02 / Product proof</p>
              <div class="case-heading-row">
                <h2>See the actual product before reading the argument.</h2>
                <p>{caseStudy.demo.durationLabel}</p>
              </div>
              <figure class="case-video-frame">
                <video controls muted playsinline preload="none" poster={caseStudy.demo.poster}>
                  <source src={caseStudy.demo.src} type="video/webm" />
                  Your browser cannot play this recording. The product frames below show the same workflow.
                </video>
                <figcaption>{caseStudy.demo.caption}</figcaption>
              </figure>

              <div class="case-contact-sheet" aria-label="BeatMind product workflow">
                {caseStudy.workflow.map((step, index) => (
                  <figure>
                    <div class="case-contact-number">{String(index + 1).padStart(2, '0')}</div>
                    <img src={step.media} width={step.width} height={step.height} loading="lazy" alt={step.alt} />
                    <figcaption><strong>{step.title}</strong><p>{step.description}</p></figcaption>
                  </figure>
                ))}
              </div>
            </section>

            <section id="problem" class="case-chapter" data-case-chapter>
              <p class="case-section-label">03 / Problem and responsibility</p>
              <h2>The browser can stop waiting. The work cannot pretend it stopped.</h2>
              {project.data.problem.map((paragraph) => <p>{paragraph}</p>)}
              <dl class="case-responsibility">
                <div><dt>Product</dt><dd>Workflow, interaction model, feedback-led refinements, and rights boundary.</dd></div>
                <div><dt>Frontend</dt><dd>Creation, library, editor, arrangement, mixing, rendering, and truthful state.</dd></div>
                <div><dt>Systems</dt><dd>Generation, separation, analysis, storage transport, durable jobs, retries, and recovery.</dd></div>
              </dl>
            </section>

            <section id="research" class="case-chapter case-research" data-case-chapter>
              <p class="case-section-label">04 / Research that changed the build</p>
              <h2>Research only matters here when it changed a decision.</h2>
              <ol>
                {caseStudy.research.map((item, index) => (
                  <li>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <div><h3>{item.source}</h3><p>{item.finding}</p><strong>{item.changed}</strong></div>
                  </li>
                ))}
              </ol>
            </section>

            <section id="architecture" class="case-chapter" data-case-chapter>
              <p class="case-section-label">05 / Architecture</p>
              <h2>{project.data.architecture.decision}</h2>
              {project.data.architecture.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              <figure class="case-system-diagram">
                <figcaption>One durable path, with late work fenced out</figcaption>
                <ol>
                  <li><span>01</span><strong>Browser</strong><small>Uploads directly and reads committed project state</small></li>
                  <li><span>02</span><strong>Web application</strong><small>Creates the operation and exposes honest progress</small></li>
                  <li><span>03</span><strong>Audio service</strong><small>Generates, separates, analyses, or renders</small></li>
                  <li><span>04</span><strong>Fenced commit</strong><small>Accepts the current attempt and refuses late work</small></li>
                </ol>
              </figure>
            </section>

            <section id="decisions" class="case-chapter case-decisions" data-case-chapter>
              <p class="case-section-label">06 / Decisions and trade-offs</p>
              <h2>What I chose, what I rejected, and what the choice costs.</h2>
              <div class="case-decision-table" role="table" aria-label="BeatMind engineering decisions">
                <div class="case-decision-head" role="row"><span role="columnheader">Decision</span><span role="columnheader">Rejected</span><span role="columnheader">Trade-off</span></div>
                {caseStudy.decisions.map((item) => (
                  <div class="case-decision-row" role="row">
                    <strong role="cell">{item.decision}</strong><p role="cell">{item.rejected}</p><p role="cell">{item.tradeoff}</p>
                  </div>
                ))}
              </div>
            </section>

            <section id="evidence" class="case-chapter case-evidence" data-case-chapter>
              <p class="case-section-label">07 / Evidence</p>
              <h2>Two measurements I can defend. No adoption theatre.</h2>
              <div class="measurement-ledger">
                {measurements.map((claim, index) => (
                  <article class:list={[index === 0 && 'is-primary']}>
                    <strong>{claim.data.display}</strong>
                    <p>{claim.data.wording}</p>
                    <small>{claim.data.denominator}</small>
                    <small>Verified {claim.data.verifiedAt.toISOString().slice(0, 10)}</small>
                  </article>
                ))}
              </div>
              <p class="case-evidence-note">I am not publishing a user count here. The account record and the definition of “user” need to agree before that number belongs in a case study.</p>
            </section>

            <section id="failures" class="case-chapter case-failures" data-case-chapter>
              <p class="case-section-label">08 / What failed</p>
              <h2>The failures are part of the architecture record.</h2>
              <ol>
                {caseStudy.failures.map((failure, index) => (
                  <li>
                    <header><span>{String(index + 1).padStart(2, '0')}</span><h3>{failure.title}</h3></header>
                    <dl>
                      <div><dt>What I saw</dt><dd>{failure.symptom}</dd></div>
                      <div><dt>Why</dt><dd>{failure.cause}</dd></div>
                      <div><dt>What changed</dt><dd>{failure.correction}</dd></div>
                      <div><dt>Still true</dt><dd>{failure.remainingRisk}</dd></div>
                    </dl>
                  </li>
                ))}
              </ol>
              {relatedNote && <a href={`/notes/${relatedNote.id}/`}>Read the consent-gate erratum <span aria-hidden="true">↗</span></a>}
            </section>

            <section id="limits" class="case-chapter case-limits" data-case-chapter>
              <p class="case-section-label">09 / Limits and future</p>
              <h2>What the product cannot do yet, beside what may come next.</h2>
              <div class="case-limits-grid">
                <div><h3>Current limitations</h3><ul>{caseStudy.limitations.map((item) => <li>{item}</li>)}</ul></div>
                <div><h3>Deliberate boundaries</h3><ul>{project.data.boundary.refuses.map((item) => <li>{item}</li>)}</ul></div>
              </div>
              <div class="case-future-list">
                {caseStudy.future.map((item) => (
                  <article><span data-status={item.status}>{item.status}</span><div><h3>{item.title}</h3><p>{item.detail}</p></div></article>
                ))}
              </div>
            </section>

            <section id="sources" class="case-chapter case-sources" data-case-chapter>
              <p class="case-section-label">10 / Stack and sources</p>
              <h2>The systems underneath it, and where this account comes from.</h2>
              <ul class="case-stack-list">{project.data.stackAndLinks.stack.map((item) => <li>{item}</li>)}</ul>
              <div class="case-source-ledger">
                {caseStudy.sources.map((source) => (
                  <div>
                    <span>{source.public ? 'Public' : 'Audited internally'}</span>
                    {source.public && source.locator.startsWith('https://')
                      ? <a href={source.locator} rel="noreferrer">{source.label} <span aria-hidden="true">↗</span></a>
                      : <strong>{source.label}</strong>}
                  </div>
                ))}
              </div>
            </section>

            <footer class="case-ending">
              <p class="case-section-label">Case 01 / Complete</p>
              <h2>The product is live. The record stays open.</h2>
              <p>BeatMind will change. When the evidence changes, this page should change with it.</p>
              <div class="case-ending-links">
                <a class="case-next" href={`/work/${project.data.next.slug}/`}>{project.data.next.label} <span aria-hidden="true">→</span></a>
                <a href="/work/">Back to all work</a>
                {relatedNote && <a href={`/notes/${relatedNote.id}/`}>Related erratum</a>}
                <a href={`${CONTACT_EMAIL_HREF}?subject=BeatMind%20case%20study`}>Ask me about BeatMind</a>
              </div>
            </footer>
          </article>
        </section>
      </div>
    </main>

    <script>
      import '../scripts/case-study-progress'
    </script>
  </body>
</html>
