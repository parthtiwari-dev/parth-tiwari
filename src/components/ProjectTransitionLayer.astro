---
import type { CollectionEntry } from 'astro:content'
import '../styles/project-transition.css'

interface Props {
  projects: CollectionEntry<'work'>[]
  worlds: CollectionEntry<'worlds'>[]
}

const { projects, worlds } = Astro.props
const publishedProjects = projects.filter((project) => project.data.caseStudy)
// A published world opts its composed still into the paper preview with staticFrame.preview.
const previewStills = new Map(
  worlds
    .filter((world) => world.data.published && world.data.staticFrame.preview)
    .map((world) => [world.data.projectSlug, world.data.staticFrame.src]),
)

const previews = publishedProjects.map((project) => {
  const proof = project.data.caseStudy!.cover.proof
  const approvedWorldStill = {
    beatmind: '/media/beatmind-world-still.jpg',
    vivid: '/media/vivid-story-loom-plate.png',
  }[project.id]
  const worldStill = approvedWorldStill ? undefined : previewStills.get(project.id)
  const imageSource = approvedWorldStill ?? worldStill
    ?? (proof.kind === 'image' ? proof.src : proof.kind === 'video' ? proof.poster : undefined)
  // World stills are 1440 x 900 composed frames; only case-study proof keeps its own fit.
  const proofImage = proof.kind === 'image' && !worldStill ? proof : undefined

  return {
    project,
    proofImage,
    proof,
    imageSource,
    sourceLabel: approvedWorldStill || worldStill ? 'Approved world still' : 'Published case-study proof',
  }
})
---

<div class="project-transition-stage" data-project-transition-stage aria-hidden="true" inert>
  {previews.map(({ project, proof, proofImage, imageSource, sourceLabel }) => (
    <figure
      class="project-world-preview"
      data-project-preview={project.id}
      data-preview-kind={imageSource ? 'image' : 'record'}
    >
      {imageSource
        ? (
            <img
              src={imageSource}
              alt=""
              width={proofImage ? proofImage.width : 1440}
              height={proofImage ? proofImage.height : 900}
              loading={project.id === 'beatmind' ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={project.id === 'beatmind' ? 'high' : 'auto'}
              data-fit={proofImage ? proofImage.fit ?? 'cover' : 'cover'}
            />
          )
        : proof.kind === 'record'
          ? (
              <div class="project-preview-record">
                <p>{proof.label}</p>
                <strong>{proof.title}</strong>
                <dl>
                  {proof.rows.slice(0, 4).map((row) => <div><dt>{row.label}</dt><dd>{row.value}</dd></div>)}
                </dl>
                <small>{proof.sourceLabel}</small>
              </div>
            )
          : null}
      <figcaption>
        <span>{project.data.title} / {sourceLabel}</span>
        <strong>{project.data.world.story}</strong>
      </figcaption>
    </figure>
  ))}
</div>
