---
import type { CollectionEntry } from 'astro:content'
import { BOOKING_URL, CONTACT_EMAIL_HREF, WHATSAPP_URL } from '../../config/site'
import '../../styles/phase2-review.css'

type Direction = 'a' | 'b' | 'c'

interface Props {
  direction: Direction
  projects: CollectionEntry<'work'>[]
  claims: CollectionEntry<'claims'>[]
  notes: CollectionEntry<'notes'>[]
  services: CollectionEntry<'services'>[]
  siteCopy: CollectionEntry<'site'>['data']
}

const { direction, projects, claims, notes, services, siteCopy } = Astro.props

const directionCopy = {
  a: {
    name: 'The Working Sheet',
    short: 'Tactile, human, direct',
    hero: siteCopy.home.hero,
    support: 'Music tools, retrieval systems, agents and generation pipelines. The case studies include what worked, what broke and what changed.',
    portrait: '/media/parth-portrait-drawn-phase2-768.png',
    portraitAlt: 'A hand-drawn study of Parth wearing a cap and sunglasses',
  },
  b: {
    name: 'The Technical Register',
    short: 'Precise, dense, evidence first',
    hero: 'I build AI products that stay honest after the demo.',
    support: 'The work is organised around systems, decisions, measurements and the limits each product keeps.',
    portrait: '/media/parth-portrait.jpg',
    portraitAlt: 'Parth standing beside a rocky river',
  },
  c: {
    name: 'Paper Over the Void',
    short: 'Cinematic, restrained, world forward',
    hero: 'I like building things that are a little too ambitious, then making them real.',
    support: 'Each project begins on the same sheet of paper. Open it and the work gets to speak in its own visual language.',
    portrait: '/media/parth-portrait-drawn-phase2-768.png',
    portraitAlt: 'A hand-drawn study of Parth wearing a cap and sunglasses',
  },
}[direction]

const orderedProjects = [...projects].sort((left, right) => left.data.order - right.data.order)
const publishedNotes = notes
  .filter((entry) => entry.data.state === 'published')
  .sort((left, right) => (right.data.publishedAt?.getTime() ?? 0) - (left.data.publishedAt?.getTime() ?? 0))
  .slice(0, 3)
const orderedServices = [...services].sort((left, right) => left.data.order - right.data.order)
const proofIds = ['beatmind-current-tests', 'beatmind-separation-benchmark', 'querypilot-correction']
const proofClaims = proofIds
  .map((id) => claims.find((claim) => claim.id === id))
  .filter((claim): claim is CollectionEntry<'claims'> => Boolean(claim?.data.publish))

const effortLabels = {
  flagship: 'Flagship',
  substantial: 'Substantial',
  focused: 'Focused',
}

const statusLabels = {
  live: 'Live',
  shipped: 'Shipped',
  'in-progress': 'In progress',
  running: 'Running',
  'take-home': 'Take-home',
}
---

<!doctype html>
<html lang="en" data-direction={direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`Phase 2 landing-page design review: ${directionCopy.name}`}
    />
    <meta name="robots" content="noindex, nofollow" />
    <title>{directionCopy.name} | Phase 2 review</title>
  </head>
  <body class:list={['phase2-demo', `direction-${direction}`]}>
    <a class="skip-link" href="#main-content">Skip to the landing-page demo</a>

    <aside class="review-rail" aria-label="Phase 2 direction selector">
      <a class="review-back" href="/review/phase-2/">Phase 2 review</a>
      <p><strong>{direction.toUpperCase()}</strong> {directionCopy.name}</p>
      <nav aria-label="Choose another direction">
        {(['a', 'b', 'c'] as const).map((item) => (
          <a href={`/review/phase-2/${item}/`} aria-current={item === direction ? 'page' : undefined}>
            {item.toUpperCase()}
          </a>
        ))}
      </nav>
    </aside>

    <div class="world-ground" aria-hidden="true">
      <div class="world-frame">
        <p>BeatMind / static world study</p>
        <img src="/media/beatmind-stems-clean.png" alt="" width="1904" height="974" />
      </div>
    </div>

    <main id="main-content" class="paper-shell">
      <div class="paper-edge paper-edge-left" aria-hidden="true"></div>
      <div class="paper-edge paper-edge-right" aria-hidden="true"></div>

      <header class="site-header">
        <a class="wordmark" href="#arrival" aria-label="Parth Tiwari, back to the top">Parth Tiwari</a>
        <nav class="desktop-nav" aria-label="Portfolio navigation">
          <a href="#projects">Work</a>
          <a href="#notes">Notes</a>
          <a href="#about">About</a>
          <a href="#contact">Resume</a>
        </nav>
        <a class="contact-action" href="#contact">Start a project</a>
        <details class="mobile-menu">
          <summary>Menu</summary>
          <nav aria-label="Mobile portfolio navigation">
            <a href="#projects">Work</a>
            <a href="#notes">Notes</a>
            <a href="#about">About</a>
            <a href="#contact">Resume</a>
          </nav>
        </details>
      </header>

      <section id="arrival" class="arrival section-pad">
        <div class="arrival-copy">
          <p class="eyebrow">AI engineer / Bengaluru / building end to end</p>
          <h1>{directionCopy.hero}</h1>
          <p class="hero-support">{directionCopy.support}</p>

          <div class="doors" aria-label="Choose how to enter the portfolio">
            <a class="door door-work" href="#projects">
              <span>{siteCopy.home.employerDoor.label}</span>
              <small>{siteCopy.home.employerDoor.note}</small>
            </a>
            <a class="door door-hire" href="#contact">
              <span>{siteCopy.home.clientDoor.label}</span>
              <small>{siteCopy.home.clientDoor.note}</small>
            </a>
          </div>
        </div>

        <figure class="arrival-world">
          <div class="world-window">
            <img src="/media/beatmind-stems-clean.png" alt="BeatMind editor showing a track split into four coloured stems" width="1904" height="974" />
          </div>
          <figcaption>
            <span>Featured world study</span>
            <strong>BeatMind</strong>
            <small>Static in Phase 2. Motion comes later.</small>
          </figcaption>
        </figure>

        <div class="quiet-proof" aria-label="Three verified examples from the work">
          {proofClaims.map((claim, index) => (
            <article>
              <span>0{index + 1}</span>
              <strong>{claim.data.display}</strong>
              <p>{claim.data.context}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="about" class="about-beat section-pad ruled-section">
        <div class="section-heading">
          <p class="eyebrow">The person on the sheet</p>
          <h2>Hi, I am Parth.</h2>
        </div>
        <figure class="portrait-frame">
          <img src={directionCopy.portrait} alt={directionCopy.portraitAlt} width={direction === 'b' ? '900' : '768'} height={direction === 'b' ? '1125' : '1152'} />
          <figcaption>{direction === 'b' ? 'The photograph' : 'A drawing study from the real portrait'}</figcaption>
        </figure>
        <div class="intro-copy">
          {siteCopy.home.intro.map((paragraph) => <p>{paragraph}</p>)}
          <a class="text-link" href="#contact">More about how I work <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section id="projects" class="project-section section-pad ruled-section">
        <div class="section-heading project-heading">
          <div>
            <p class="eyebrow">The register</p>
            <h2>Work, in the order I would show it.</h2>
          </div>
          <p>Every project stays on the sheet. The full register will add sorting by build effort, recency and current status.</p>
        </div>

        <div class="register-layout">
          <ol class="project-register">
            {orderedProjects.map((project, index) => (
              <li class:list={['project-row', project.data.tier === 'flagship' && 'is-flagship']} tabindex="0">
                <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
                <div class="project-name">
                  <strong>{project.data.title}</strong>
                  <p>{project.data.summary}</p>
                </div>
                <span class="project-meta">{statusLabels[project.data.status]}</span>
                <span class="project-meta effort">{effortLabels[project.data.effort]}</span>
                <span class="project-arrow" aria-hidden="true">↗</span>
              </li>
            ))}
          </ol>

          <aside id="project-preview" class="register-preview" aria-label="Static preview framing study">
            <p class="eyebrow">Preview behavior arrives in Phase 4</p>
            <img src="/media/beatmind-stems-clean.png" alt="Static BeatMind world frame used to study project preview placement" width="1904" height="974" />
            <div>
              <strong>When a row reaches the centre</strong>
              <p>The real version will reveal that project’s approved frame without covering its name or capturing the scroll.</p>
            </div>
          </aside>
        </div>
      </section>

      <section class="proof-section section-pad ruled-section">
        <div class="section-heading">
          <p class="eyebrow">Measured, with the denominator attached</p>
          <h2>Proof without the victory lap.</h2>
        </div>
        <div class="proof-grid">
          {proofClaims.map((claim, index) => (
            <article>
              <span class="proof-number">{claim.data.display}</span>
              <p>{claim.data.wording}</p>
              <small>Verified {claim.data.verifiedAt.toISOString().slice(0, 10)} / {claim.data.denominator}</small>
            </article>
          ))}
        </div>
      </section>

      <section class="services-section section-pad ruled-section">
        <div class="section-heading">
          <p class="eyebrow">Three kinds of work</p>
          <h2>Where I can be useful.</h2>
        </div>
        <div class="service-list">
          {orderedServices.map((service, index) => (
            <article>
              <span>0{index + 1}</span>
              <h3>{service.data.title}</h3>
              <p>{service.data.outcome}</p>
              <ul>
                {service.data.scope.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section id="notes" class="notes-section section-pad ruled-section">
        <div class="section-heading notes-heading">
          <div>
            <p class="eyebrow">Errata and writing</p>
            <h2>The parts I got wrong stay public.</h2>
          </div>
          <div class="writing-status">
            <span>Writing</span>
            <strong>Coming soon</strong>
            <small>The errata are already open.</small>
          </div>
        </div>
        <div class="note-list">
          {publishedNotes.map((note, index) => (
            <article>
              <span>0{index + 1}</span>
              <div>
                <h3>{note.data.title}</h3>
                <p>{note.data.summary}</p>
              </div>
              <small>{note.data.publishedAt?.toISOString().slice(0, 10)}</small>
            </article>
          ))}
        </div>
      </section>

      <section id="contact" class="contact-section section-pad ruled-section">
        <p class="eyebrow">The client door, again</p>
        <h2>Have something real to build?</h2>
        <p>{siteCopy.hire.intro}</p>
        <div class="contact-links">
          <a class="contact-action large" href={CONTACT_EMAIL_HREF}>Email Parth</a>
          <a class="text-link" href={BOOKING_URL}>Book a call <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={WHATSAPP_URL}>WhatsApp <span aria-hidden="true">↗</span></a>
        </div>
        <small class="demo-caveat">Review demo only. The final contact hierarchy is not approved yet.</small>
      </section>

      <footer class="site-footer">
        <strong>Parth Tiwari</strong>
        <p>{directionCopy.name} / landing-page exploration / Phase 2</p>
        <a href="#arrival">Back to the top ↑</a>
      </footer>
    </main>
  </body>
</html>
