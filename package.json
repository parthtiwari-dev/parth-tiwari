{
  "name": "parth-tiwari-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/run-astro-build.mjs",
    "content:check": "node scripts/phase1-content-check.mjs",
    "content:test-schemas": "node scripts/phase1-schema-test.mjs",
    "phase1:gate": "npm run content:test-schemas && npm run content:check && npm run build",
    "phase2:capture": "node scripts/phase2-capture.mjs",
    "phase2:work-capture": "node scripts/phase2-work-capture.mjs",
    "phase2:case-capture": "node scripts/phase2-case-study-capture.mjs",
    "phase2:notes-capture": "node scripts/phase2-notes-capture.mjs",
    "phase2:about-capture": "node scripts/phase2-about-capture.mjs",
    "phase2:resume-capture": "node scripts/phase2-resume-capture.mjs",
    "phase2:hire-capture": "node scripts/phase2-hire-capture.mjs",
    "phase2:gate": "node scripts/phase2-gate.mjs",
    "phase3:case-batch-gate": "npm run content:test-schemas && npm run content:check && npm run build && node scripts/phase3-case-study-batch-gate.mjs",
    "phase3:static-gate": "npm run phase3:case-batch-gate && node scripts/phase3-static-site-gate.mjs",
    "phase4:study": "node scripts/phase4-motion-study-server.mjs",
    "phase4:study-capture": "node scripts/phase4-motion-study-capture.mjs",
    "phase4:gate": "npm run phase3:static-gate && node scripts/phase4-production-gate.mjs",
    "phase5:world-gate": "node scripts/phase5-world-gate.mjs",
    "phase5:gate": "npm run phase4:gate && npm run phase5:world-gate",
    "phase6:vivid-gate": "npm run phase5:gate && node scripts/phase6-vivid-world-gate.mjs",
    "phase6:tathya-gate": "npm run phase6:vivid-gate && node scripts/phase6-tathya-world-gate.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "shots": "node scripts/shots.mjs",
    "capture": "node scripts/capture-demos.mjs",
    "craft": "node scripts/craft-check.mjs",
    "a11y": "node scripts/a11y-check.mjs",
    "perf": "node scripts/perf-check.mjs",
    "perf:scroll": "node scripts/scroll-perf-check.mjs"
  },
  "dependencies": {
    "astro": "7.2.9"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
