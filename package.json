{
  "name": "parth-tiwari-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/run-astro-build.mjs",
    "content:check": "node scripts/phase1-content-check.mjs",
    "content:test-schemas": "node scripts/phase1-schema-test.mjs",
    "phase1:gate": "npm run content:test-schemas && npm run content:check && npm run build",
    "phase2:capture": "node scripts/phase2-capture.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "shots": "node scripts/shots.mjs",
    "capture": "node scripts/capture-demos.mjs",
    "craft": "node scripts/craft-check.mjs",
    "a11y": "node scripts/a11y-check.mjs",
    "perf": "node scripts/perf-check.mjs",
    "perf:scroll": "node scripts/scroll-perf-check.mjs"
  },
  "dependencies": {
    "astro": "7.2.9"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
